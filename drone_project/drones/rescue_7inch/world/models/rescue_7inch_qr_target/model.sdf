<?xml version="1.0"?>
<sdf version="1.9">
  <model name="qr_target">
    <static>true</static>

    <link name="link">

      <visual name="qr_visual">
        <pose>0 0 0.01 0 0 0</pose>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>2 2</size>
          </plane>
        </geometry>

        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rescue_7inch_qr_target/materials/textures/qr.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.9</roughness>
            </metal>
          </pbr>
        </material>

        <cast_shadows>false</cast_shadows>
      </visual>

    </link>
  </model>
</sdf>
