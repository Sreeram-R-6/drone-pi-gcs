      <visual name='rear_right_leg_visual'>
        <pose>-0.075 -0.055 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <link name='imu_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.010</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name='imu_joint' type='revolute'>
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Sensor-role links represent the BLITZ Mini F745 architecture.
         Their masses are included in the 1.500 kg AUW budget. -->
    <link name='gps_link'>
      <inertial>
        <mass>0.010</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name='gps_sensor' type='navsat'>
        <gz_frame_id>gps_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
      </sensor>
    </link>
    <joint name='gps_joint' type='fixed'>
      <parent>base_link</parent><child>gps_link</child>
    </joint>

    <link name='barometer_link'>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name='barometer_sensor' type='air_pressure'>
        <gz_frame_id>barometer_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
    </link>
    <joint name='barometer_joint' type='fixed'>
      <parent>base_link</parent><child>barometer_link</child>
    </joint>

    <link name='compass_link'>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name='compass_sensor' type='magnetometer'>
        <gz_frame_id>compass_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </link>
    <joint name='compass_joint' type='fixed'>
      <parent>base_link</parent><child>compass_link</child>
    </joint>

  <link name='rotor_0'>
    <pose>+0.113137 -0.113137 0.030 0 0 0</pose>

    <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.035</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>


    <visual name='propeller_visual'>
