      <visual name='base_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.34 0.34 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.14 0.14 0.14 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
          <pbr>
            <metal>
              <metalness>0.35</metalness>
              <roughness>0.55</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name='front_left_leg_visual'>
        <pose>0.075 0.055 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name='front_right_leg_visual'>
        <pose>0.075 -0.055 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
          <pbr>
