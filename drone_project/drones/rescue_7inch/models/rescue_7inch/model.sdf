<?xml version='1.0'?>
<sdf version='1.9'>
	<model name="rescue_7inch">
  <!-- Model-level flag is required for included-model links to receive wind. -->
  <enable_wind>true</enable_wind>
  <self_collide>false</self_collide>
    <pose>0 0 0 0 0 0</pose>
    <link name='base_link'>
      <!-- Required for Gazebo WindEffects to apply physical wind force. -->
      <enable_wind>true</enable_wind>
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.0</angular>
      </velocity_decay>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.33</mass>
        <inertia>
          <ixx>0.020</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.020</iyy>
          <iyz>0</iyz>
          <izz>0.035</izz>
        </inertia>
      </inertial>
<!-- Downward RGB camera -->
      <sensor name="down_camera" type="camera">
        <pose>0 0 -0.10 0 1.5708 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>500</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
      </sensor>

      <collision name='base_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.14 0.045</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='front_left_leg_collision'>
        <pose>0.075 0.055 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='front_right_leg_collision'>
        <pose>0.075 -0.055 -0.11 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
