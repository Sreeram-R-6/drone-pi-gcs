[Unit]
Description=Bidirectional multi-client drone MAVLink hub
After=mavproxy.service network.target
Wants=mavproxy.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 -B "@ROOT@/scripts/mavlink_hub.py"
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
